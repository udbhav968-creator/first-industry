# Environment Configuration Template
# COPY TO .env BEFORE RUNNING - NEVER COMMIT REAL SECRETS

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=techstack_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/techstack_db

# Clerk Authentication (Milestone 5)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
CLERK_SECRET_KEY=sk_test_placeholder_key

# External AI & Search Services (Milestone 2.5 & 2.6)
SEARXNG_URL=http://searxng:8080
CRAWL4AI_URL=http://crawl4ai:11235
ANTHROPIC_API_KEY=placeholder_anthropic_api_key
